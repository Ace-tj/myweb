  "about": {
    "eyebrow": "About us",
    "title": "We sold the same starter twice and never wrote the proposal again.",
    "p1": "Pixelforge is a small studio that ships web systems in two-week cycles. We noticed every client kept describing the same software: bookings, a CRM, an admin, payments. So we built those once — really well — and now we re-skin them.",
    "p2": "That means lower price, faster launch, and code that's been battle-tested across dozens of projects rather than written from zero on yours. We still tailor it: your colors, your data, your integrations. Only the boring stuff stays the same.",
    "cards": {
      "goal": {
        "title": "Single goal",
        "body": "Ship a working system, not a deck. Every meeting drives toward a staging link."
      },
      "team": {
        "title": "Six people",
        "body": "Two designers, three engineers, one PM. You'll know all six by name."
      },
      "speed": {
        "title": "Two weeks",
        "body": "Average from kickoff to launch. Larger scope still ships in 6-8 weeks."
      }
    },
    "howWeWorkTitle": "How we work",
    "steps": [
      {
        "label": "Pick a demo.",
        "body": " Browse the gallery, open one in your browser, share with stakeholders. If something isn't there, tell us and we'll either add it or scope it as bespoke."
      },
      {
        "label": "20-minute brief.",
        "body": " One call, one shared doc. We finalize palette, copy, integrations, and the first three things we're cutting from your wishlist."
      },
      {
        "label": "Daily staging.",
        "body": " You get a link that updates every day. Comment inline, we ship the same afternoon."
      },
      {
        "label": "Launch + 60 days.",
        "body": " Production go-live and bug fixes for free. After that we offer a flat monthly retainer."
      }
    ]
  },
  "services": {
    "title": "What we actually do",
    "lede": "Every project includes the bullets below. Pick the ones you need on the quote; we'll skip the rest.",
    "items": {
      "branding": {
        "title": "Brand + UI tailoring",
        "body": "We re-skin one of our demos to your palette, typography, and tone. Includes a 30-page design review."
      },
      "hosting": {
        "title": "Hosting + deployment",
        "body": "We ship to Vercel, your VPS, or your existing cloud. SSL, domains, backups — handled."
      },
      "integrations": {
        "title": "Integrations",
        "body": "Stripe, payment.tj, Telegram bot, WhatsApp Business, Twilio, your accounting software, REST/GraphQL APIs."
      },
      "data": {
        "title": "Custom data model",
        "body": "Need fields the demo doesn't have? We add them, with admin UI and proper validation, in the first week."
      },
      "i18n": {
        "title": "Multi-language",
        "body": "Russian and Tajik built in. We can add Uzbek, Arabic, or any RTL language with a day of localization."
      },
      "compliance": {
        "title": "Compliance + audit",
        "body": "GDPR-ready data export, role-based access control, audit log, and a security report on launch."
      }
    },
    "ctaTitle": "Not sure which service fits?",
    "ctaLede": "Open a demo, tell us what's missing. We'll send a quote in 24 hours.",
